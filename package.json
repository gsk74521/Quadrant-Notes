{
  "name": "quadrant-notes",
  "productName": "四象限便签",
  "version": "1.1.0",
  "description": "四象限时间管理便签 · 跨平台桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac"
  },
  "author": "FQTM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsk74521/Quadrant-Notes.git"
  },
  "homepage": "https://github.com/gsk74521/Quadrant-Notes",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fqtm.quadrantnotes",
    "productName": "四象限便签",
    "files": [
      "main.js",
      "preload.js",
      "startup.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Quadrant-Notes-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    }
  }
}
